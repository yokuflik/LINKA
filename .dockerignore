# Keep the build context (and the final image) small — it is copied whole
# into the runtime stage.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Rust build output — huge, and rebuilt inside each image / via a cache mount.
target/
**/target/

# Tests never run inside the image.
tests/

# Dev-only fixtures / assets.
mock_photos/
poc/                     # served by Caddy from a bind mount, not the image

# Docs & planning.
*.md
# docs/agent_knowledge/*.md is read at import time by modules/agents/help_docs.py (ADR 0092)
docs/*
!docs/agent_knowledge
.claude_docs/
PROMPT_LOG.md

# Local env / compose / editor.
.env
.env.*
docker-compose.yml
docker-compose.prod.yml
deploy/
.idea/
.vscode/
.DS_Store
