# Keep the build context (and the final image) small — it is copied whole
# into the runtime stage.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Tests never run inside the image.
tests/

# Dev-only fixtures / assets.
mock_photos/
poc/                     # served by Caddy from a bind mount, not the image

# Docs & planning.
*.md
docs/
.claude_docs/
PROMPT_LOG.md

# Local env / compose / editor.
.env
.env.*
docker-compose.yml
docker-compose.prod.yml
deploy/
.idea/
.vscode/
.DS_Store
