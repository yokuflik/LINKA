# Copy to .env for local development. Every value here has a working default
# in config.py / database.connection.py / services.redis_client.py, so a
# missing .env only breaks the two that are required (DATABASE_URL, REDIS_URL).

# --- Required ---
DATABASE_URL=postgresql+asyncpg://test_user:test_password@localhost:5433/test_db
REDIS_URL=redis://localhost:6380/0

# --- Object storage (local MinIO: docker compose `test_minio`) ---
# S3 API on 9100, web console on 9101 (creds below). Leave S3_ENDPOINT_URL
# unset in production so boto3 talks to real AWS S3.
S3_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY=linka_dev
S3_SECRET_KEY=linka_dev_secret
# S3_REGION=us-east-1
# S3_BUCKET_MEDIA=linka-media
# S3_BUCKET_AVATARS=linka-avatars
# S3_AVATARS_PUBLIC_BASE_URL=http://localhost:9100/linka-avatars

# --- Optional overrides (see config.py for the full list + defaults) ---
# JWT_SECRET_KEY=dev-secret-change-me
# CORS_ALLOW_ORIGINS=*
# UPLOAD_URL_EXPIRY_SECONDS=900
# DOWNLOAD_URL_EXPIRY_SECONDS=3600
