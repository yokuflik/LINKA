# Linka reverse proxy (ADR 0007).
#
# SITE_ADDRESS drives everything:
#   - a hostname (linka.example.com)  -> automatic HTTPS via Let's Encrypt
#   - ":80"                           -> plain HTTP, reached by the server's
#                                        raw IP (no domain yet)
#
# The API + WebSocket and the static PoC are served from the SAME origin, so
# the browser makes same-origin calls and CORS never comes into play.
#
# Object storage (MinIO) is NOT proxied here: without a dedicated hostname a
# path prefix would break S3 SigV4 (the signed path must reach MinIO
# unchanged). Until you add a domain, MinIO stays on the internal network and
# the app talks to it directly (S3_ENDPOINT_URL=http://minio:9000). Browser
# media upload/download starts working once S3 gets its own hostname — see
# deploy/README.md.

{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Backend API + WebSocket. Everything else is the static PoC.
	@api path /auth* /users* /chats* /ws /healthz /docs* /redoc* /openapi.json
	handle @api {
		reverse_proxy app:8000
	}

	handle {
		root * /srv/poc
		file_server
	}
}
