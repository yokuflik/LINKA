# Linka reverse proxy (ADR 0007 + ADR 0012 transport hardening).
#
# SITE_ADDRESS drives everything:
#   - a hostname (linka.example.com)  -> automatic HTTPS via Let's Encrypt
#   - ":80"                           -> plain HTTP, reached by the server's
#                                        raw IP (no domain yet)
#
# The API + WebSocket and the static PoC are served from the SAME origin, so
# the browser makes same-origin calls and CORS never comes into play.
#
# Object storage (MinIO) is NOT proxied here: without a dedicated hostname a
# path prefix would break S3 SigV4 (the signed path must reach MinIO
# unchanged). Until you add a domain, MinIO stays on the internal network and
# the app talks to it directly (S3_ENDPOINT_URL=http://minio:9000). Browser
# media upload/download starts working once S3 gets its own hostname -- see
# deploy/README.md.
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# --- Security headers (ADR 0012) ---
	# HSTS: full 1-year policy now that Linka is on its own registered domain
	# (linka-web.com, 2026-09-06) - no longer sharing a sslip.io parent, so
	# includeSubDomains + preload are safe. Submit to hstspreload.org once
	# this has been live and stable for a while.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Minimal CSP for the single-file PoC: it inlines its own script/style
		# and loads the Vue + Firebase SDKs plus avatars/media over https.
		# 'unsafe-eval' is required: the PoC ships the Vue *runtime compiler*
		# build (vue.global.js) and every component uses an inline `template:`
		# string, which Vue compiles at runtime via new Function(). Removing it
		# blanks the whole app ("Evaluating a string as JavaScript violates ...
		# CSP"). The real client app (with a build step + precompiled
		# templates) would not need this.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss:; font-src 'self' https: data:; frame-src https:; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Internal-only endpoints (ADR 0036) are never reachable from the edge.
	handle /internal* {
		respond 404
	}

	# WebSocket. During the Rust-gateway canary (ADR 0033): /ws -> the Rust
	# ws_gateway, /ws-legacy -> the Python app (rewritten back to /ws) for
	# instant rollback. Flip both to the same target at cutover (Step 8).
	handle /ws {
		reverse_proxy ws_gateway:8081
	}
	handle /ws-legacy {
		rewrite * /ws
		reverse_proxy app:8000
	}

	# Backend API. Everything else is the static PoC.
	@api path /auth* /users* /chats* /scheduled-messages* /healthz /docs* /redoc* /openapi.json
	handle @api {
		# Uploads go straight to S3 via a presigned PUT, so the API itself
		# never legitimately receives a large body.
		request_body {
			max_size 2MB
		}
		reverse_proxy app:8000
	}

	handle {
		root * /srv/poc

		# Entry points must always revalidate with the server so a fresh deploy
		# is picked up immediately - mobile browsers otherwise cache index.html
		# hard and only Incognito shows the new build.
		@entry path / /index.html /manifest.webmanifest /sw.js
		header @entry {
			Cache-Control "no-cache, no-store, must-revalidate"
			Pragma "no-cache"
			Expires "0"
		}

		# Static assets carry a ?v=<release> query string (JS/CSS) or are
		# content-named (images), so they can be cached. 1 day (not immutable)
		# since the query string, not a content hash, is what busts them.
		@assets path *.js *.css *.png *.jpg *.jpeg *.webp *.svg *.woff2
		header @assets Cache-Control "public, max-age=86400"

		file_server
	}
}
