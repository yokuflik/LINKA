# ---------------------------------------------------------------------------
# Linka production / demo environment (ADR 0007).
#
#   cp deploy/env.production.example .env
#   # then edit every value marked <CHANGE ME>
#
# .env is git-ignored. docker-compose.prod.yml reads it for both interpolation
# and as the app container's env_file.
# ---------------------------------------------------------------------------

# --- Public addresses (Caddy) ---------------------------------------------
# A real hostname gets an automatic Let's Encrypt cert. Use ":80" instead for
# plain HTTP with no domain (browsers then block WebSocket-over-TLS and mixed
# content, so a domain is strongly recommended - DuckDNS is free).
SITE_ADDRESS=linka.example.com
S3_ADDRESS=s3.linka.example.com
ACME_EMAIL=you@example.com

# --- Postgres ------------------------------------------------------------
POSTGRES_USER=linka
POSTGRES_PASSWORD=<CHANGE ME - long random>
POSTGRES_DB=linka

# DATABASE_URL / REDIS_URL are set to the in-compose service names by
# docker-compose.prod.yml; no need to set them here.

# --- Auth --------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET_KEY=<CHANGE ME - openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS -------------------------------------------------------------
# The PoC is served from SITE_ADDRESS, so that is the only allowed origin.
# Comma-separated if you add more. Never "*" here (allow_credentials=True).
CORS_ALLOW_ORIGINS=https://linka.example.com

# --- Instance identity (exactly one instance) -------------------------
SNOWFLAKE_MACHINE_ID=1
SERVER_ID=linka-1

# --- Object storage (in-compose MinIO) -------------------------------
# S3_ENDPOINT_URL host MUST equal S3_ADDRESS above. Switch to real AWS S3
# later by blanking S3_ENDPOINT_URL and setting real keys + region.
S3_ENDPOINT_URL=https://s3.linka.example.com
S3_ACCESS_KEY=<CHANGE ME>
S3_SECRET_KEY=<CHANGE ME - long random>
S3_REGION=us-east-1
S3_BUCKET_MEDIA=linka-media
S3_BUCKET_AVATARS=linka-avatars
S3_AVATARS_PUBLIC_BASE_URL=https://s3.linka.example.com/linka-avatars

# --- Small-host sizing (see database/connection.py, config.py) --------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
REDIS_MAX_CONNECTIONS=50

# Redis is capped at 128 MB - keep the streams small on a demo box. One
# app process means one consumer, so a single shard is simplest.
MESSAGE_SEND_STREAM_MAXLEN=20000
MESSAGE_FANOUT_STREAM_MAXLEN=20000
RECEIPT_STREAM_MAXLEN=20000
SEND_STREAM_SHARDS=1
FANOUT_STREAM_SHARDS=1

# --- Partition retention (see config.py / ADR 0005) ------------------
RECEIPT_LOG_RETENTION_DAYS=30

# --- OTP: deliberate open stub (demo, no SMS budget) -----------------
# Any 6-digit code verifies once one has been requested. Nothing to set.
