# ---------------------------------------------------------------------------
# Linka production / demo environment (ADR 0007).
#
#   cp deploy/env.production.example .env
#   # then edit every value marked <CHANGE ME>
#
# .env is git-ignored. docker-compose.prod.yml reads it for both interpolation
# and as the app container's env_file.
# ---------------------------------------------------------------------------

# --- Public address (Caddy) ---------------------------------------------
# A real hostname gets an automatic Let's Encrypt cert. Use ":80" for plain
# HTTP reached by the server's raw IP (no domain yet - see deploy/README.md).
# Comma-separate to serve several names (e.g. apex + www).
SITE_ADDRESS=linka-web.com, www.linka-web.com

# Only used to register with Let's Encrypt when SITE_ADDRESS is a hostname
# (cert-expiry notices). Unused with ":80". Linka never sends email.
ACME_EMAIL=admin@localhost

# S3 gets its own hostname only once you have a domain; until then MinIO is
# internal-only and S3_ADDRESS is unused.
# S3_ADDRESS=s3.linka.example.com

# --- Postgres ------------------------------------------------------------
POSTGRES_USER=linka
POSTGRES_PASSWORD=<CHANGE ME - long random>
POSTGRES_DB=linka

# DATABASE_URL / REDIS_URL are set to the in-compose service names by
# docker-compose.prod.yml; no need to set them here.

# --- Auth --------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET_KEY=<CHANGE ME - openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS / hosts (ADR 0012) -----------------------------------------
# The PoC is served from SITE_ADDRESS, so that is the only allowed origin.
# Used for both CORS and the WebSocket handshake Origin check. Comma-separated
# if you add more. Never "*" here (that forces allow_credentials off and lets
# any Origin open a WebSocket).
CORS_ALLOW_ORIGINS=https://linka-web.com,https://www.linka-web.com
# Host header allowlist (TrustedHostMiddleware). "*" disables the check.
ALLOWED_HOSTS=linka-web.com,www.linka-web.com,localhost
# Direct-peer IPs whose X-Forwarded-For first hop is trusted as the client IP.
# Default is the docker bridge range + loopback; only override for an unusual
# network. TRUSTED_PROXY_IPS=172.16.0.0/12,127.0.0.1/32
# Coarse per-IP REST backstop: 1000 requests / 180 s / IP.
# API_IP_BACKSTOP_MAX=1000
# API_IP_BACKSTOP_WINDOW_SECONDS=180

# --- Auth / OTP rate limits (COMMS_SECURITY_PLAN step 4) --------------
# Ship generous, tighten from real metrics. All are env-overridable.
# Per-phone OTP request limit (retuned from 20/10min):
# OTP_REQUEST_RATE_LIMIT_MAX=5
# OTP_REQUEST_RATE_LIMIT_WINDOW_SECONDS=1800
# Per-IP ceilings (one host spraying OTPs across many numbers):
# OTP_REQUEST_IP_RATE_LIMIT_MAX=15
# OTP_REQUEST_IP_RATE_LIMIT_WINDOW_SECONDS=3600
# OTP_VERIFY_IP_RATE_LIMIT_MAX=30
# OTP_VERIFY_IP_RATE_LIMIT_WINDOW_SECONDS=3600
# /auth/refresh: per-IP + per-refresh-token-jti throttle:
# REFRESH_IP_RATE_LIMIT_MAX=60
# REFRESH_IP_RATE_LIMIT_WINDOW_SECONDS=3600
# REFRESH_JTI_RATE_LIMIT_MAX=10
# REFRESH_JTI_RATE_LIMIT_WINDOW_SECONDS=3600
# New accounts per IP per day (strict):
# ACCOUNT_CREATE_IP_RATE_LIMIT_MAX=5
# ACCOUNT_CREATE_IP_RATE_LIMIT_WINDOW_SECONDS=86400

# --- WebSocket connection cap + handshake churn (step 5) -------------
# Hard cap on concurrent WS connections per user (evict oldest on the 6th):
# WS_CONN_MAX_CONNECTIONS=5
# WS_CONN_MAX_AGE_SECONDS=93600
# Handshake-churn throttle on successful /ws upgrades (close 4429):
# WS_UPGRADE_IP_RATE_LIMIT_MAX=20
# WS_UPGRADE_IP_RATE_LIMIT_WINDOW_SECONDS=10
# WS_UPGRADE_USER_RATE_LIMIT_MAX=10
# WS_UPGRADE_USER_RATE_LIMIT_WINDOW_SECONDS=10
# WS_MAX_CHAT_IDS_ON_CONNECT=2000

# --- WebSocket per-frame + per-action limits (step 6) ---------------
# Inbound frame rate per connection (drop frame, then close 4429 after
# WS_FRAME_FLOOD_STRIKES consecutive over-limit frames):
# WS_FRAME_RATE_MAX=30
# WS_FRAME_RATE_WINDOW_SECONDS=10
# WS_FRAME_FLOOD_STRIKES=60
# send_message: 3/s primary + 40/60s sustained ceiling (both must pass):
# WS_SEND_MESSAGE_RATE_MAX=3
# WS_SEND_MESSAGE_RATE_WINDOW_SECONDS=1
# WS_SEND_MESSAGE_BURST_MAX=40
# WS_SEND_MESSAGE_BURST_WINDOW_SECONDS=60
# Per-action buckets (per user):
# WS_RECEIPTS_RATE_MAX=60          # mark_delivered/read/played combined
# WS_RECEIPTS_RATE_WINDOW_SECONDS=10
# WS_SUBSCRIBE_PRESENCE_RATE_MAX=20
# WS_SUBSCRIBE_PRESENCE_RATE_WINDOW_SECONDS=10
# WS_TYPING_RATE_MAX=10            # typing/recording combined
# WS_TYPING_RATE_WINDOW_SECONDS=10
# WS_EDIT_RATE_MAX=20             # edit/delete/restore_message combined
# WS_EDIT_RATE_WINDOW_SECONDS=60

# --- REST feature limits (step 7) ----------------------------------
# GET /chats/{id}/messages - history pagination (per user); `limit` is
# additionally clamped to [1, MSG_HISTORY_MAX_LIMIT] server-side:
# MSG_HISTORY_RATE_MAX=30
# MSG_HISTORY_RATE_WINDOW_SECONDS=60
# MSG_HISTORY_MAX_LIMIT=100
# POST /chats/{id}/messages/upload-ticket - per user + per IP:
# UPLOAD_TICKET_RATE_MAX=5
# UPLOAD_TICKET_RATE_WINDOW_SECONDS=60
# UPLOAD_TICKET_IP_RATE_LIMIT_MAX=20
# UPLOAD_TICKET_IP_RATE_LIMIT_WINDOW_SECONDS=60
# Per-message detail reads (GET .../{message_id}/receipts):
# DETAIL_READ_RATE_MAX=60
# DETAIL_READ_RATE_WINDOW_SECONDS=60
# List reads (GET /chats, GET /users/*):
# LIST_READ_RATE_MAX=120
# LIST_READ_RATE_WINDOW_SECONDS=60

# --- Instance identity (exactly one instance) -------------------------
SNOWFLAKE_MACHINE_ID=1
SERVER_ID=linka-1

# --- Snowflake ID service (Rust, ADR 0011) ---------------------------
# docker-compose.prod.yml already sets ID_SERVICE_ADDR=id_service:50051 and
# NODE_ID=2 on the containers. Leave ID_SERVICE_ADDR unset here to keep the
# in-process generator (SNOWFLAKE_MACHINE_ID) instead. NODE_ID must differ
# from SNOWFLAKE_MACHINE_ID.
# ID_SERVICE_ADDR=id_service:50051
ID_SERVICE_TIMEOUT_SECONDS=0.5

# --- Rust WebSocket gateway (ADR 0033) ------------------------------
# Built off-host and pushed to a registry (see deploy/README.md). Set this to
# the pushed tag so the server pulls instead of building. Unset -> compose
# tries to build locally (fine on a dev machine, OOMs the t3.micro).
# WS_GATEWAY_IMAGE=<registry>/linka-ws-gateway:<tag>
# The gateway reads JWT_SECRET (= the app's JWT_SECRET_KEY), REDIS_URL,
# CORS_ALLOW_ORIGINS and APP_INTERNAL_URL — all wired in docker-compose.prod.yml.
# SERVER_ID is intentionally NOT passed to it (self-generates a per-process UUID).

# --- Object storage (in-compose MinIO) -------------------------------
# S3_ENDPOINT_URL host MUST equal S3_ADDRESS above. Switch to real AWS S3
# later by blanking S3_ENDPOINT_URL and setting real keys + region.
S3_ENDPOINT_URL=https://s3.linka.example.com
S3_ACCESS_KEY=<CHANGE ME>
S3_SECRET_KEY=<CHANGE ME - long random>
S3_REGION=us-east-1
S3_BUCKET_MEDIA=linka-media
S3_BUCKET_AVATARS=linka-avatars
S3_AVATARS_PUBLIC_BASE_URL=https://s3.linka.example.com/linka-avatars

# --- Small-host sizing (see database/connection.py, config.py) --------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
REDIS_MAX_CONNECTIONS=50

# Redis is capped at 128 MB - keep the streams small on a demo box. One
# app process means one consumer, so a single shard is simplest.
MESSAGE_SEND_STREAM_MAXLEN=20000
MESSAGE_FANOUT_STREAM_MAXLEN=20000
RECEIPT_STREAM_MAXLEN=20000
SEND_STREAM_SHARDS=1
FANOUT_STREAM_SHARDS=1

# --- Partition retention (see config.py / ADR 0005) ------------------
RECEIPT_LOG_RETENTION_DAYS=30

# --- Phone verification (Firebase Phone Auth, ADR 0009) --------------
# Real numbers verify client-side via Firebase; the server checks the
# resulting ID token against Google's JWKS. Set this to the Firebase
# project id. Leave empty to disable the real path (only the dev
# whitelist below can then log in).
FIREBASE_PROJECT_ID=linka-3a9cf
# Also add SITE_ADDRESS's host to Firebase -> Authentication -> Settings
# -> Authorized domains. Nothing to mount (manual JWKS, no service acct).

# --- Dev auth whitelist (bypasses ALL verification) -----------------
# Exact phone-number strings that skip verification and use the legacy
# open OTP stub (any code works). These are NOT real numbers. Keep this
# to a tiny set; never expand it for a real user-facing environment.
DEV_AUTH_WHITELIST=1,2,3,4,5
